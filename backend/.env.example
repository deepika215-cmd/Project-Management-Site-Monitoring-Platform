# ==============================
# BuildTrack backend environment
# ==============================

# Local development database
DATABASE_URL=sqlite:///./buildtrack.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://buildtrack_user:change_me@localhost:5432/buildtrack

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL used in reset-password email links
FRONTEND_BASE_URL=http://localhost:4200

# Local testing only:
# true  = show reset link on frontend if SMTP is missing/fails
# false = never show reset token/link on screen; real email only
BUILDTRACK_EXPOSE_RESET_LINK=false

# ==============================
# Real SMTP email configuration
# ==============================
# Example Gmail settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_16_digit_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=BuildTrack
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BuildTrack
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_DEBUG=false
